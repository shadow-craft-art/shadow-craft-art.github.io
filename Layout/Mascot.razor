<svg class="mascot" viewBox="0 0 420 420" role="img" aria-label="A little purple octopus in a witch hat resting in a golden crescent moon">
    <defs>
        <radialGradient id="mc-body" cx="40%" cy="30%" r="80%">
            <stop offset="0" stop-color="#e0c8ff" />
            <stop offset=".55" stop-color="#9a6bf5" />
            <stop offset="1" stop-color="#5f35c4" />
