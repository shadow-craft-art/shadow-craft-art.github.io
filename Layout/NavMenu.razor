<header class="top">
    <div class="top-inner">
        <a class="brand" href="">
            <Logo />
            <span class="brand-text">Shadow Craft <em>Art</em></span>
        </a>

        <nav class="tabs" aria-label="Main menu">
            <ul>
                @foreach (var section in SiteData.Sections)
                {
                    <li class="tab">
                        <NavLink class="tab-link" href="@section.Href" Match="@MatchFor(section)">@section.Title</NavLink>
                        @if (section.Items.Length > 0)
                        {
                            <div class="panel">
                                <ul>
                                    @foreach (var item in section.Items)
                                    {
                                        <li><a href="@LinkFor(section, item)">@item</a></li>
                                    }
                                </ul>
                            </div>
                        }
                    </li>
                }
            </ul>
        </nav>
    </div>
</header>

@code {
    private static NavLinkMatch MatchFor(NavSection section) =>
        section.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix;

    private static string LinkFor(NavSection section, string item) =>
        section.Href + "#" + SiteData.Slug(item);
}
